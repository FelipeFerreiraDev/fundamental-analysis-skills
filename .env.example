# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o git.

# brapi.dev — cotação do dia. Token gratuito em https://brapi.dev
BRAPI_TOKEN=

# Opcional: pasta dos dados locais (banco, cache, PDFs). Padrão: data/
# DATA_DIR=

# URLs dos serviços externos (todos gratuitos). Os valores abaixo são os padrões
# usados quando a variável não está no .env.
CVM_BASE_URL=https://dados.cvm.gov.br/dados/CIA_ABERTA
B3_COTAHIST_BASE_URL=https://bvmf.bmfbovespa.com.br/InstDados/SerHist
BRAPI_BASE_URL=https://brapi.dev/api
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie
