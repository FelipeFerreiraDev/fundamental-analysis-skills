{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FinancialValue": {
      "additionalProperties": false,
      "description": "A single number with everything needed to trace and audit it.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "BRL",
            "BRL/share",
            "shares",
            "ratio",
            "count"
          ],
          "title": "Unit",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "basis": {
          "anyOf": [
            {
              "enum": [
                "consolidated",
                "individual",
                "prudential",
                "managerial"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for accounting data; null for market and macro data.",
          "title": "Basis"
        },
        "nature": {
          "enum": [
            "reported",
            "derived",
            "estimated"
          ],
          "title": "Nature",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How a derived value was computed, or why an estimate was chosen.",
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "period",
        "nature",
        "confidence"
      ],
      "title": "FinancialValue",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Reference period of a value. Balance sheet items are INSTANT and have no start.",
      "properties": {
        "type": {
          "enum": [
            "INSTANT",
            "3M",
            "YTD",
            "FY",
            "LTM"
          ],
          "title": "Type",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "type",
        "end"
      ],
      "title": "Period",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ticker": {
      "pattern": "^[A-Z]{4}[0-9]{1,2}$",
      "title": "Ticker",
      "type": "string"
    },
    "reference_date": {
      "format": "date",
      "title": "Reference Date",
      "type": "string"
    },
    "snapshot_as_of": {
      "format": "date-time",
      "title": "Snapshot As Of",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "$ref": "#/$defs/FinancialValue"
      },
      "description": "Point-in-time indicators.",
      "title": "Values",
      "type": "object"
    },
    "series": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/FinancialValue"
        },
        "type": "array"
      },
      "description": "Historical series (e.g. dividends per share by year).",
      "title": "Series",
      "type": "object"
    },
    "unavailable": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Indicator -> reason it could not be computed.",
      "title": "Unavailable",
      "type": "object"
    }
  },
  "required": [
    "ticker",
    "reference_date",
    "snapshot_as_of",
    "generated_at",
    "engine_version",
    "values"
  ],
  "title": "IndicatorsReport",
  "type": "object"
}
